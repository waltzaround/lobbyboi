{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lobbyboi-arena",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-20",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "ARENA", "class_name": "ArenaRoom" },
      { "name": "LOBBY", "class_name": "LobbyDirectory" }
    ]
  },
  // SQLite-backed classes. Migrations are append-only: never edit or remove a tag.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArenaRoom", "LobbyDirectory"] }],
  "observability": { "enabled": true }
}
