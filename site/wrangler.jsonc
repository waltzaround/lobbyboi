{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lobbyboi",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-20",
  "routes": [{ "pattern": "lobbyboi.walt.online", "custom_domain": true }],
  "assets": { "directory": "./dist", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "ARENA", "class_name": "ArenaRoom" },
      { "name": "LOBBY", "class_name": "LobbyDirectory" }
    ]
  },
  // Append-only: never edit or remove a tag.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArenaRoom", "LobbyDirectory"] }],
  "observability": { "enabled": true }
}
