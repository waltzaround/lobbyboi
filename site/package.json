{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/setup.mjs && concurrently -k -n worker,vite -c blue,magenta \"wrangler dev --port 8799 --inspector-port 9239\" \"vite --port 5180\"",
    "build": "vite build",
    "typecheck": "tsc -b",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "arena": "workspace:*",
    "lobbyboi": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.9",
    "vite": "^8",
    "wrangler": "^4.142.0"
  }
}
